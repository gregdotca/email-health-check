# Copy to .env and fill in. The mail settings and TRUSTED_MX_HOSTS are required; the rest
# are optional: leave a line out (or empty) to get the default shown, except SENDING_EMAIL_FROM_NAME,
# where an empty value means no display name.

# --- Receiving: the mailbox people send tests to (IMAP over TLS, port 993) ---
RECEIVING_EMAIL_HOST='mail.example.net'
# The address people send tests to (never answered, nor is anything else at its domain)
RECEIVING_EMAIL_ADDRESS='health-check@example.com'
# The IMAP login: often the same as the address, but not when the test address is an alias
RECEIVING_EMAIL_USER='health-check@example.com'
RECEIVING_EMAIL_PASSWORD=''

# --- Sending: where the results emails go out (SMTP with STARTTLS) ---
SENDING_EMAIL_HOST='smtp.example.net'
# True starts TLS (STARTTLS) before logging in (True or False)
SENDING_EMAIL_USE_TLS='True'
SENDING_EMAIL_PORT='587'
SENDING_EMAIL_HOST_USER=''
SENDING_EMAIL_HOST_PASSWORD=''
# The results emails' From address (default: RECEIVING_EMAIL_ADDRESS) and display name (default: APP_NAME)
#SENDING_EMAIL_FROM='health-check@example.com'
#SENDING_EMAIL_FROM_NAME='Email Health Check'

# Seconds between mailbox checks (at least 10)
POLL_SECONDS=30

# Read-only test run: nothing is flagged, deleted or sent (True or False)
#DRY_RUN=True

# --- App settings (services/web/healthcheck/settings.py) ---
# The web page the results emails link to (no trailing slash, no path). Leave it empty for email-only:
# no web page, no link in the emails, and no reports kept
PUBLIC_URL='https://health-check.example.com'
# Docker Compose starts the web page only with "web" here; leave it empty for email-only (with PUBLIC_URL)
COMPOSE_PROFILES='web'
# The receiving mail servers whose Received: headers are trusted, comma-separated: the server that
# accepts mail for the mailbox, and any backup MX that relays to it. The parser expects Exim's format.
TRUSTED_MX_HOSTS='mx1.example.net,mx2.example.net'
# Time zone for the times in the reports
DISPLAY_TIMEZONE='UTC'
# Reverse proxies in front of the web page (0 if it's reached directly)
TRUSTED_PROXY_HOPS=1
# Where the web page listens on the host, as IP:port (docker-compose.yml only)
WEB_BIND='127.0.0.1:8080'
# Container names: this, and this plus "-poller"; give each instance on a host its own (docker-compose.yml only)
CONTAINER_NAME='health-check'
# Name on the web page, in the report emails and on the summary picture
APP_NAME='Email Health Check'
# The documentation at /docs/ on the web page (True or False)
DOCS_ENABLED=True

# Results are kept this long if nobody looks them up, then deleted this long after the page first shows them
RESULTS_KEPT_HOURS=24
RESULTS_KEPT_AFTER_VIEW_MINUTES=5

# Web lookups per client IP
LOOKUPS_PER_MINUTE=10
LOOKUPS_PER_HOUR=60

# Results emails: per recipient, and in total from everyone (a hard daily ceiling)
MAIL_PER_RECIPIENT_PER_HOUR=5
MAIL_PER_RECIPIENT_PER_DAY=10
MAIL_PER_DAY=50
