# Copy to .env, fill in the first section, and you're done. Everything below it is optional and already
# set to its default: change a line only if you want something different.

# ==========================================================================================================
# 1. FILL THESE IN
# ==========================================================================================================

# --- The test mailbox: where people send tests (IMAP over TLS, port 993) ---
RECEIVING_EMAIL_HOST='mail.example.net'
# The address people send tests to (never answered, nor is anything else at its domain)
RECEIVING_EMAIL_ADDRESS='health-check@example.com'
# The IMAP login: often the same as the address, but not when the test address is an alias
RECEIVING_EMAIL_USER='health-check@example.com'
RECEIVING_EMAIL_PASSWORD=''

# --- Sending: the SMTP service the report emails go out through ---
SENDING_EMAIL_HOST='smtp.example.net'
# The SMTP login (most services need one)
SENDING_EMAIL_HOST_USER=''
SENDING_EMAIL_HOST_PASSWORD=''

# --- Your receiving mail servers ---
# The names your receiving server writes after "by" in the Received: headers of mail it accepts (usually
# its MX host names), comma-separated, including any backup MX. The parser expects Exim's format.
TRUSTED_MX_HOSTS='mx1.example.net,mx2.example.net'

# --- The web page (optional, but set both lines either way) ---
# The web page's address, with no trailing slash or path. The report emails link to it.
PUBLIC_URL='https://health-check.example.com'
# Read by Docker Compose, not the app: "web" turns on the Compose profile that starts the web page's
# container. Set both lines, or neither. For email-only, leave this and PUBLIC_URL empty: no web page, no
# link in the emails, and no reports kept.
COMPOSE_PROFILES='web'

# ==========================================================================================================
# 2. OPTIONAL: these are the defaults
# ==========================================================================================================

# --- Sending ---
SENDING_EMAIL_PORT='587'
# True starts TLS (STARTTLS) before logging in (True or False)
SENDING_EMAIL_USE_TLS='True'
# The report emails' From address (default: RECEIVING_EMAIL_ADDRESS) and display name (default: APP_NAME).
# Leave these commented out for the defaults. An empty SENDING_EMAIL_FROM_NAME means no display name.
#SENDING_EMAIL_FROM='health-check@example.com'
#SENDING_EMAIL_FROM_NAME='Email Health Check'

# --- Checking the mailbox ---
# Seconds between mailbox checks (at least 10). Required: keep a value here.
POLL_SECONDS=30
# Read-only test run: nothing is flagged, deleted or sent (True or False)
#DRY_RUN=True

# --- Name and time zone ---
# Name on the web page, in the report emails and on the summary picture
APP_NAME='Email Health Check'
# Time zone for the times in the reports, such as America/New_York
DISPLAY_TIMEZONE='UTC'

# --- The web page ---
# Where the web page listens on the host, as IP:port (docker-compose.yml only)
WEB_BIND='127.0.0.1:8080'
# Container names: this, and this plus "-poller". Give each copy on a host its own (docker-compose.yml only).
CONTAINER_NAME='health-check'
# Reverse proxies in front of the web page (0 if it's reached directly)
TRUSTED_PROXY_HOPS=1
# The documentation at /docs/ on the web page (True or False)
DOCS_ENABLED=True
# Your own HTML for the <head> of every web page (visitor statistics and the like), left off the pages the
# report links open. Wrap it in single quotes and write \' for a quote inside. It can span several lines.
# Inline <script> and <style> blocks are allowed automatically, but not onload= or style= attributes.
# For example: CUSTOM_HEADER_HTML='<script defer src="https://stats.example.com/script.js"></script>'
CUSTOM_HEADER_HTML=''
# What that code may load, added to the pages' Content-Security-Policy (script-src, connect-src, img-src,
# style-src, font-src, frame-src, media-src, worker-src, manifest-src), separated by semicolons
# For example: CUSTOM_HEADER_CSP='script-src https://stats.example.com; connect-src https://stats.example.com'
CUSTOM_HEADER_CSP=''

# --- Keeping reports (with the web page) ---
# Kept this long if nobody looks them up, then deleted this long after the page first shows them
RESULTS_KEPT_HOURS=24
RESULTS_KEPT_AFTER_VIEW_MINUTES=5

# --- Limits ---
# Web lookups per client IP
LOOKUPS_PER_MINUTE=10
LOOKUPS_PER_HOUR=60
# Report emails: per recipient, and in total from everyone (a hard daily ceiling)
MAIL_PER_RECIPIENT_PER_HOUR=5
MAIL_PER_RECIPIENT_PER_DAY=10
MAIL_PER_DAY=50
